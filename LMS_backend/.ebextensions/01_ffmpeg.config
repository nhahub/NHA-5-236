commands:
  01_download_ffmpeg:
    command: "wget -O /tmp/ffmpeg.tar.xz https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz"
    test: "[ ! -f /usr/local/bin/ffmpeg ]"
  02_mkdir_ffmpeg:
    command: "mkdir -p /opt/ffmpeg"
    test: "[ ! -f /usr/local/bin/ffmpeg ]"
  03_extract_ffmpeg:
    command: "tar -xJf /tmp/ffmpeg.tar.xz -C /opt/ffmpeg --strip-components=1"
    test: "[ ! -f /usr/local/bin/ffmpeg ]"
  04_link_ffmpeg:
    command: "ln -s /opt/ffmpeg/ffmpeg /usr/local/bin/ffmpeg"
    test: "[ ! -f /usr/local/bin/ffmpeg ]"
  05_link_ffprobe:
    command: "ln -s /opt/ffmpeg/ffprobe /usr/local/bin/ffprobe"
    test: "[ ! -f /usr/local/bin/ffprobe ]"
  06_cleanup:
    command: "rm -f /tmp/ffmpeg.tar.xz"